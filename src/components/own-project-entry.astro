---
// Compact "What I Build" card: screenshot, linked title, the "why" question, stack, then the
// Markdown body behind a "More" button so the card fits in about one screen.
import '../styles/prose-article-body.css';
import { render, type CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url-helpers';

interface Props {
  entry: CollectionEntry<'ownProjects'>;
}
const { entry } = Astro.props;
const { title, tagline, status, role, started, url, repoUrl, stack, screenshot, why } = entry.data;
const { Content } = await render(entry);
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<article class="project" id={entry.id}>
  {/* always 5 children (shot, header, why, stack, more): they line up with the next card via subgrid */}
  <figure class="shot">
    {
      screenshot &&
        (url ? (
          <a href={url} {...ext} tabindex="-1" aria-hidden="true">
            <img src={withBase(screenshot)} alt="" width="1200" height="675" loading="lazy" />
          </a>
        ) : (
          <img src={withBase(screenshot)} alt={`${title} home page`} width="1200" height="675" loading="lazy" />
        ))
    }
  </figure>

  <header>
    <p class="meta">
      <span class:list={['status', status.toLowerCase()]}>{status}</span>
      <span class="since mono">Since {started}</span>
    </p>
    <h2>
      {
        url ? (
          <a href={url} {...ext}>
            {title}&nbsp;<span class="arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          title
        )
      }
    </h2>
    <p class="tagline">{tagline}</p>
    <p class="role">{role}</p>
  </header>

  <details class="fold why">
    <summary>{why.question}</summary>
    <p>{why.answer}</p>
  </details>

  <div class="stack-row">
    <ul class="stack" aria-label="Built with">
      {stack.map((tool) => <li class="tag">{tool}</li>)}
    </ul>
    {!url && <span class="soon mono">Launching soon</span>}
    {
      repoUrl && (
        <a class="arrow-link" href={repoUrl} {...ext}>
          Code ↗
        </a>
      )
    }
  </div>

  <details class="fold more">
    <summary>More</summary>
    <div class="prose body">
      <Content />
    </div>
  </details>
</article>

<style>
  /* cards in the same row share row heights (subgrid), so every row lines up across cards */
  .project {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    margin-bottom: 18px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 14px 16px 6px;
    scroll-margin-top: 24px;
    min-width: 0;
  }
  .project > * {
    align-self: start;
  }
  .shot {
    margin: 0 0 12px;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: calc(var(--radius) - 6px);
    transition: transform 0.3s var(--ease-out);
  }
  .shot a:hover img {
    transform: translateY(-2px);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0 0 6px;
  }
  .status {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
  }
  .status.live {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bar-strong);
  }
  .status.prototype,
  .status.building {
    background: rgba(143, 211, 174, 0.25);
    border-color: var(--bar);
    color: var(--accent-strong);
  }
  .since {
    font-size: 11px;
    color: var(--ink-faint);
  }
  h2 {
    font-size: 23px;
    line-height: 1.2;
    margin: 0;
  }
  h2 a {
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(var(--bar-strong), var(--bar-strong));
    background-size: 0 6px;
    background-position: 0 92%;
    background-repeat: no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }
  h2 a:hover,
  h2 a:focus-visible {
    background-size: 100% 6px;
  }
  .arrow {
    font-size: 0.7em;
    color: var(--ink-soft);
  }
  .tagline {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 5px 0 0;
  }
  .role {
    font-size: 12px;
    color: var(--ink-faint);
    margin: 4px 0 12px;
  }

  /* the "why" question and the "More" button share one look */
  .fold {
    font-size: 14.5px;
    line-height: 1.6;
  }
  .fold summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15.5px;
    color: var(--ink);
  }
  .fold summary::-webkit-details-marker {
    display: none;
  }
  .fold summary::after {
    content: '+';
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-soft);
    transition: transform 0.25s var(--ease-out), background 0.2s;
  }
  .fold[open] > summary::after {
    transform: rotate(45deg);
    background: var(--bar);
  }
  .fold summary:hover::after {
    background: var(--bar);
  }
  .fold summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .why {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .why p {
    margin: 0 0 12px;
  }
  .more summary {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink-soft);
    justify-content: flex-start;
  }
  .more summary::after {
    order: -1;
  }

  /* Markdown body inside "More": one ### heading per question */
  .body {
    padding-bottom: 10px;
  }
  .body :global(h3) {
    font-size: 15.5px;
    margin: 14px 0 6px;
  }
  .body :global(h3:first-child) {
    margin-top: 4px;
  }
  .body :global(p),
  .body :global(ul) {
    margin: 0;
  }
  .body :global(ul) {
    padding-left: 18px;
  }
  .body :global(li + li) {
    margin-top: 6px;
  }
  .body :global(.note) {
    margin: 12px 0 0;
    padding-top: 0;
    border-top: 0;
    font-size: 11px;
  }

  .stack-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 12px 0 4px;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stack :global(.tag) {
    font-size: 10.5px;
    padding: 2px 7px;
  }
  .soon {
    font-size: 11.5px;
    color: var(--ink-faint);
  }
</style>
