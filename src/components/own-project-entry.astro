---
import '../styles/prose-article-body.css';
import { render, type CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url-helpers';

interface Props {
  entry: CollectionEntry<'ownProjects'>;
}
const { entry } = Astro.props;
const { title, tagline, status, role, started, url, repoUrl, stack, screenshot } = entry.data;
const { Content } = await render(entry);
---

<article class="project" id={entry.id}>
  <header>
    <p class="meta">
      <span class:list={['status', status.toLowerCase()]}>{status}</span>
      <span class="eyebrow">Since {started} · {role}</span>
    </p>
    <h2>{title}</h2>
    <p class="tagline">{tagline}</p>
  </header>

  <div class="prose body">
    <Content />
  </div>

  {
    screenshot && (
      <figure class="shot">
        {url ? (
          <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${title}`}>
            <img src={withBase(screenshot)} alt={`${title} home page`} width="1200" height="675" loading="lazy" />
          </a>
        ) : (
          <img src={withBase(screenshot)} alt={`${title} home page`} width="1200" height="675" loading="lazy" />
        )}
      </figure>
    )
  }

  <footer>
    <ul class="stack" aria-label="Built with">
      {stack.map((tool) => <li class="tag">{tool}</li>)}
    </ul>
    <p class="links">
      {
        url ? (
          <a class="visit" href={url} target="_blank" rel="noopener noreferrer">
            Visit {title} ↗
          </a>
        ) : (
          <span class="soon mono">Launching soon</span>
        )
      }
      {
        repoUrl && (
          <a class="arrow-link" href={repoUrl} target="_blank" rel="noopener noreferrer">
            Code ↗
          </a>
        )
      }
    </p>
  </footer>
</article>

<style>
  .project {
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: clamp(20px, 4vw, 36px);
    scroll-margin-top: 24px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-bottom: 10px;
  }
  .status {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
  }
  .status.live {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bar-strong);
  }
  .status.prototype,
  .status.building {
    background: rgba(143, 211, 174, 0.25);
    border-color: var(--bar);
    color: var(--accent-strong);
  }
  h2 {
    font-size: clamp(28px, 4vw, 38px);
  }
  .tagline {
    font-size: 18px;
    color: var(--ink-soft);
    margin: 8px 0 0;
  }
  .body {
    margin-top: 24px;
    font-size: 16px;
  }
  /* each section is a <details>: only the question shows until the reader opens it */
  .body :global(details) {
    border-top: 1px solid var(--rule);
  }
  .body :global(details:last-of-type) {
    border-bottom: 1px solid var(--rule);
  }
  .body :global(summary) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 2px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    color: var(--ink);
  }
  .body :global(summary::-webkit-details-marker) {
    display: none;
  }
  .body :global(summary::after) {
    content: '+';
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--ink-soft);
    transition: transform 0.25s var(--ease-out), background 0.2s;
  }
  .body :global(details[open] > summary::after) {
    transform: rotate(45deg);
    background: var(--bar);
  }
  .body :global(summary:hover::after) {
    background: var(--bar);
  }
  .body :global(summary:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .body :global(details > :not(summary)) {
    margin-top: 0;
  }
  .body :global(details > :last-child) {
    margin-bottom: 18px;
  }
  .body :global(.note) {
    margin-top: 14px;
  }
  .shot {
    margin: 24px 0 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: calc(var(--radius) - 4px);
    box-shadow: var(--shadow);
    transition: transform 0.3s var(--ease-out);
  }
  .shot a:hover img {
    transform: translateY(-3px);
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px dashed var(--rule);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0;
  }
  .visit {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    color: var(--paper);
    background: var(--ink);
    padding: 9px 14px;
    border-radius: 8px;
  }
  .visit:hover {
    color: var(--paper);
    background: var(--accent);
  }
  .soon {
    font-size: 12.5px;
    color: var(--ink-faint);
  }
</style>
