---
// Swipeable viewer for dashboard PDF pages (CSS scroll-snap + src/scripts/page-swiper.ts).
//   variant="full"    → dashboard page: big slides, controls row, "Open full PDF" link
//   variant="compact" → dashboard card: small slides, overlay arrows, counter pill; slides link to `href`
import { withBase } from '../lib/url-helpers';

interface Props {
  pages: string[];
  title: string;
  pdf?: string;
  variant?: 'full' | 'compact';
  href?: string;
}
const { pages, pdf, title, variant = 'full', href } = Astro.props;
const compact = variant === 'compact';
---

<section
  class:list={['swiper', variant]}
  data-swiper
  aria-roledescription="carousel"
  aria-label={`${title} — dashboard pages`}
>
  <div class="track" data-track tabindex="0" aria-label="Swipe, drag or use arrow keys to change page">
    {
      pages.map((src, i) => (
        <figure class="slide" aria-roledescription="slide" aria-label={`Page ${i + 1} of ${pages.length}`}>
          {compact && href ? (
            <a href={href} tabindex="-1">
              <img src={withBase(src)} alt="" width="1800" height="1040" loading="lazy" decoding="async" />
            </a>
          ) : (
            <img
              src={withBase(src)}
              alt={`${title} — page ${i + 1}`}
              width="1800"
              height="1040"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          )}
        </figure>
      ))
    }
  </div>
  <div class="controls">
    <button type="button" class="nav prev" data-prev aria-label="Previous page">←</button>
    <span class="counter mono" aria-live="polite"><span data-current>1</span> / {pages.length}</span>
    <button type="button" class="nav next" data-next aria-label="Next page">→</button>
    {
      !compact && pdf && (
        <a class="arrow-link pdf-link" href={withBase(pdf)} target="_blank" rel="noopener">
          Open full PDF ↗
        </a>
      )
    }
  </div>
</section>

<script>
  import '../scripts/page-swiper';
</script>

<style>
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    background: var(--paper-raised);
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  .slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
  }
  .slide img {
    width: 100%;
    height: auto;
    display: block;
  }
  .nav {
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
  }
  .nav:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .nav:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .counter {
    color: var(--ink-soft);
    text-align: center;
  }

  /* full: dashboard detail page */
  .full .track {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .full .controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }
  .full .nav {
    width: 40px;
    height: 40px;
    font-size: 16px;
  }
  .full .counter {
    font-size: 13px;
    min-width: 48px;
  }
  .full .pdf-link {
    margin-left: auto;
  }

  /* compact: dashboard card thumbnail — sits above the card's full-card link */
  .compact {
    position: relative;
    z-index: 1;
    height: 100%;
  }
  .compact .track {
    height: 100%;
  }
  .compact .slide img {
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .compact .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    font-size: 14px;
    box-shadow: var(--shadow);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .compact .prev {
    left: 10px;
  }
  .compact .next {
    right: 10px;
  }
  .compact:hover .nav:not(:disabled),
  .compact .nav:focus-visible {
    opacity: 1;
  }
  .compact .counter {
    position: absolute;
    right: 10px;
    bottom: 10px;
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(22, 24, 28, 0.72);
    color: var(--paper);
  }
  @media (hover: none) {
    .compact .nav {
      display: none;
    }
  }
</style>
