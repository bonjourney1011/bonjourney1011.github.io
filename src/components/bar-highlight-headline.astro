---
// Big headline where one phrase sits on a bar-chart bar that "grows" on load.
interface Props {
  before: string;
  highlight: string;
  after?: string;
  caption?: string;
}
const { before, highlight, after = '', caption } = Astro.props;
---

<div class="headline-wrap">
  <h1>
    {before} <span class="bar">{highlight}</span>{after}
  </h1>
  {caption && <p class="caption mono">{caption}</p>}
</div>

<style>
  h1 {
    font-size: clamp(38px, 6.2vw, 66px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.012em;
    font-variation-settings: 'opsz' 72;
    max-width: 15ch;
  }
  .bar {
    position: relative;
    z-index: 0;
    padding: 0 0.12em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    background-image: linear-gradient(var(--bar-strong), var(--bar-strong));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 100% 46%;
    animation: grow 1.1s var(--ease-out) 0.25s both;
  }
  @keyframes grow {
    from {
      background-size: 0% 46%;
    }
  }
  .caption {
    margin-top: 18px;
    font-size: 12.5px;
    color: var(--ink-faint);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .caption::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--ink-faint);
  }
</style>
