---
// Inputs for the portfolio optimizer: tickers, risk-free rate, volatility cap, date windows and mode.
// Dates are filled in by src/scripts/portfolio-optimizer/optimizer-form-inputs.ts (last 3 years, 75/25 split).
---

<form class="controls" novalidate>
  <label class="field tickers">
    <span class="eyebrow">Stocks: 2–20 HOSE / HNX / UPCOM tickers</span>
    <input name="tickers" value="FPT, VCB, HPG, MWG, GAS, VNM, REE, BSR" autocomplete="off" spellcheck="false" />
  </label>
  <label class="field">
    <span class="eyebrow">Risk-free rate, %/yr</span>
    <input name="rf" type="number" inputmode="decimal" step="0.1" min="0" max="30" value="4.4" />
  </label>
  <label class="field">
    <span class="eyebrow">Volatility cap <span class="sigma">σ</span>, %/yr</span>
    <input name="cap" type="number" inputmode="decimal" step="0.5" min="1" max="200" value="15" />
  </label>
  <label class="field">
    <span class="eyebrow">Estimate from</span>
    <input name="start" type="date" min="2017-08-24" />
  </label>
  <label class="field">
    <span class="eyebrow">Test from</span>
    <input name="split" type="date" />
  </label>
  <label class="field">
    <span class="eyebrow">Test to</span>
    <input name="end" type="date" />
  </label>
  <fieldset class="mode">
    <legend class="eyebrow">Portfolio type</legend>
    <label><input type="radio" name="mode" value="stocks-only" checked /> Stocks only</label>
    <label><input type="radio" name="mode" value="with-risk-free" /> Stocks + risk-free asset (CAL)</label>
  </fieldset>
  <button type="submit">Optimise</button>
  <p class="hint">
    VN-Index is added as the benchmark. Default Rf ≈ Vietnam 10-year government bond yield (about 4.4% in 2026). Leave
    "Test from" empty to estimate on the whole range.
  </p>
</form>

<style>
  .controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px 18px;
    padding: 22px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .tickers,
  .mode,
  .hint {
    grid-column: 1 / -1;
  }
  input:not([type='radio']) {
    font: 500 15px var(--font-mono);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 9px 11px;
    width: 100%;
  }
  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .mode {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
  }
  .mode legend {
    float: left;
    margin-right: 6px;
  }
  .mode label {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    cursor: pointer;
  }
  .mode input {
    accent-color: var(--accent);
  }
  button {
    grid-column: 1 / -1;
    justify-self: start;
    font: 600 15px var(--font-body);
    color: #fff;
    background: var(--accent);
    border: 0;
    border-radius: 999px;
    padding: 11px 26px;
    cursor: pointer;
    transition: background 0.2s var(--ease-out);
  }
  button:hover {
    background: var(--accent-strong);
  }
  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .sigma {
    text-transform: none;
  }
  .hint {
    margin: 0;
    font-size: 13px;
    color: var(--ink-faint);
  }
  @media (max-width: 640px) {
    .controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 16px;
    }
  }
</style>
