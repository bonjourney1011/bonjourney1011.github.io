---
import '../../styles/prose-article-body.css';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/base-layout.astro';
import ArticleFactStrip from '../../components/article-fact-strip.astro';
import DashboardCard from '../../components/dashboard-card.astro';
import PortfolioOptimizerTool from '../../components/portfolio-optimizer/portfolio-optimizer-tool.astro';
import { categoryLabels, getPublishedWork } from '../../lib/content-queries';
import { withBase } from '../../lib/url-helpers';

export async function getStaticPaths() {
  const work = await getPublishedWork();
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const dashboard = data.dashboard ? await getEntry('dashboards', data.dashboard) : undefined;

const facts = [
  { label: 'Role', value: data.role },
  { label: 'Period', value: data.period },
  { label: 'Stack', value: data.stack.join(', ') },
  ...(data.repoUrl ? [{ label: 'Code', value: 'GitHub repository', href: data.repoUrl }] : []),
];
---

<BaseLayout title={data.title} description={data.summary} ogImage={data.cover}>
  <article class="container article">
    <a class="arrow-link back" href={withBase('/work')}>← All case studies</a>
    <p class="eyebrow kicker">{data.kind} · {categoryLabels[data.category]}</p>
    <h1>{data.title}</h1>
    <p class="lead">{data.summary}</p>

    <div class="headline-metric">
      <span class="value mono">{data.metric.value}</span>
      <span class="label">{data.metric.label}</span>
    </div>

    <ArticleFactStrip facts={facts} />

    {data.tool === 'portfolio-optimizer' && <PortfolioOptimizerTool />}

    <div class="prose body">
      <Content />
    </div>

    {
      dashboard && !dashboard.data.draft && (
        <aside class="related" aria-label="Related dashboard">
          <p class="eyebrow">Explore the dashboard</p>
          <DashboardCard entry={dashboard} />
        </aside>
      )
    }

    <nav class="next" aria-label="Next case study">
      <span class="eyebrow">Next case study</span>
      <a href={withBase(`/work/${next.id}`)}>{next.data.title} →</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 860px;
    padding-top: 16px;
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
  }
  .kicker {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(34px, 5.4vw, 54px);
    margin: 8px 0 16px;
  }
  .lead {
    font-size: 19px;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .headline-metric {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 28px 0;
  }
  .headline-metric .value {
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    background: linear-gradient(transparent 58%, var(--bar) 58%);
  }
  .headline-metric .label {
    color: var(--ink-soft);
    max-width: 30ch;
  }
  .body {
    margin-top: 44px;
  }
  .related {
    margin-top: 56px;
    max-width: 420px;
  }
  .related .eyebrow {
    margin-bottom: 10px;
  }
  .next {
    margin-top: 64px;
    padding-top: 22px;
    border-top: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .next a {
    font-family: var(--font-display);
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 700;
    text-decoration: none;
  }
</style>
