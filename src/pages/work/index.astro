---
import SidebarPageLayout from '../../layouts/sidebar-page-layout.astro';
import FilterableWorkList from '../../components/filterable-work-list.astro';
import { getPublishedWork } from '../../lib/content-queries';

const work = await getPublishedWork();
---

<SidebarPageLayout
  title="Work"
  description="Case studies in e-commerce, finance, analytics engineering and research: the business question, the approach and the measurable outcome."
>
  <header class="page-head">
    <p class="eyebrow">Case studies</p>
    <h1>Business questions, answered with data.</h1>
    <p class="lead">
      Each case study follows the same shape: the decision at stake, what I did, the measurable outcome, and what I would
      improve next. Employer work is anonymised.
    </p>
  </header>
  <FilterableWorkList entries={work} />
</SidebarPageLayout>

<style>
  .page-head h1 {
    font-size: clamp(34px, 5vw, 50px);
    margin: 6px 0 14px;
    max-width: 16ch;
  }
  .lead {
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0;
  }
</style>
