---
import SidebarPageLayout from '../layouts/sidebar-page-layout.astro';
import OwnProjectEntry from '../components/own-project-entry.astro';
import { getPublishedOwnProjects } from '../lib/content-queries';

const projects = await getPublishedOwnProjects();
---

<SidebarPageLayout
  title="What I Build"
  description="Products I design, build and run on my own, from the first question to the live site."
>
  <header class="page-head">
    <p class="eyebrow">What I build · {projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
    <h1>Things I build on my own.</h1>
    <p class="lead">
      Products I design, build and run myself: I own the problem, the content, the code and the hosting, from the
      first question to the live site.
    </p>
  </header>
  <div class="list">
    {projects.map((entry) => <OwnProjectEntry entry={entry} />)}
  </div>
</SidebarPageLayout>

<style>
  .page-head h1 {
    font-size: clamp(34px, 5vw, 50px);
    margin: 6px 0 14px;
    max-width: 16ch;
  }
  .lead {
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0;
  }
  /* two cards per row; one per row on phones */
  .list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 18px;
    row-gap: 0; /* cards are subgrids spanning 4 rows; they space themselves with margin-bottom */
  }
  @media (min-width: 560px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
