---
import SidebarPageLayout from '../layouts/sidebar-page-layout.astro';
import OwnProjectEntry from '../components/own-project-entry.astro';
import { getPublishedOwnProjects } from '../lib/content-queries';

const projects = await getPublishedOwnProjects();
---

<SidebarPageLayout
  title="My Own"
  description="Products and ventures I build on my own: where data analysis meets owning the business outcome."
>
  <header class="page-head">
    <p class="eyebrow">My own · {projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
    <h1>Things I build on my own.</h1>
    <p class="lead">
      Side ventures where I own the whole problem — the market, the numbers and the product. Analysis feels different
      when the P&amp;L is yours.
    </p>
  </header>
  <div class="list">
    {projects.map((entry) => <OwnProjectEntry entry={entry} />)}
  </div>
</SidebarPageLayout>

<style>
  .page-head h1 {
    font-size: clamp(34px, 5vw, 50px);
    margin: 6px 0 14px;
    max-width: 16ch;
  }
  .lead {
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0;
  }
  .list {
    display: grid;
    gap: 20px;
  }
</style>
