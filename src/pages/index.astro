---
import SidebarPageLayout from '../layouts/sidebar-page-layout.astro';
import BarHighlightHeadline from '../components/bar-highlight-headline.astro';
import ImpactLedger from '../components/impact-ledger.astro';
import CaseStudyCard from '../components/case-study-card.astro';
import DashboardCard from '../components/dashboard-card.astro';
import WorkingPrinciples from '../components/working-principles.astro';
import RecognitionList from '../components/recognition-list.astro';
import { getPublishedDashboards, getPublishedWork } from '../lib/content-queries';
import { withBase } from '../lib/url-helpers';

const work = await getPublishedWork();
const featured = work.filter((e) => e.data.featured);
const dashboards = (await getPublishedDashboards()).slice(0, 2);
---

<SidebarPageLayout>
  <section aria-label="Introduction">
    <BarHighlightHeadline
      before="I turn messy commerce data into"
      highlight="decisions that move revenue"
      after="."
      caption="Data analyst · economics & finance by training · e-commerce by trade"
    />
  </section>

  <ImpactLedger />

  <section aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">Selected work</h2>
      <a class="arrow-link" href={withBase('/work')}>All {work.length} case studies →</a>
    </div>
    <div class="stack">
      {featured.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </section>

  <section aria-labelledby="dash-title">
    <div class="section-head">
      <h2 id="dash-title">Dashboards</h2>
      <a class="arrow-link" href={withBase('/dashboards')}>View all →</a>
    </div>
    <div class="grid">
      {dashboards.map((entry) => <DashboardCard entry={entry} />)}
    </div>
  </section>

  <WorkingPrinciples />

  <RecognitionList limit={4} />
</SidebarPageLayout>

<style>
  .stack {
    display: grid;
    gap: 16px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
